---
import { Image } from "astro:assets";
---

<header
    transition:persist="site-header"
    class="sticky top-0 z-50 mb-10 px-4 mx-auto w-full flex justify-between items-center p-2 bg-slate-700/80 supports-[backdrop-filter]:bg-slate-700/65 backdrop-blur-md border-b border-slate-400/30"
>
    <a id="logo-link" href="/#hero" class="logo relative inline-flex">
        <Image
            src="/icon.webp"
            alt="Logo"
            width={64}
            height={64}
            class="logo-img w-16 h-16"
        />
        <span class="logo-burst" aria-hidden="true">
            <span class="ray" style="--a: 0deg"></span>
            <span class="ray" style="--a: 45deg"></span>
            <span class="ray" style="--a: 90deg"></span>
            <span class="ray" style="--a: 135deg"></span>
            <span class="ray" style="--a: 180deg"></span>
            <span class="ray" style="--a: 225deg"></span>
            <span class="ray" style="--a: 270deg"></span>
            <span class="ray" style="--a: 315deg"></span>
        </span>
    </a>

    <!-- Botón hamburguesa animado -->
    <button
        id="menu-button"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="menu-button md:hidden relative z-50 flex flex-col justify-center items-center gap-1.5 w-10 h-10 rounded-lg transition-colors hover:bg-slate-600/60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
    >
        <span class="bar bar-1 block w-6 h-0.5 rounded-full bg-slate-100"></span>
        <span class="bar bar-2 block w-6 h-0.5 rounded-full bg-slate-100"></span>
        <span class="bar bar-3 block w-6 h-0.5 rounded-full bg-slate-100"></span>
    </button>

    <!-- Navegación Desktop -->
    <nav class="hidden md:block">
        <ul class="flex gap-7 items-center">
            <li>
                <a
                    class="group inline-flex items-center gap-2 hover:underline hover:decoration-cyan-400"
                    href="/tfg"
                >
                    <span>TFG</span>
                    <span
                        class="text-[8px] font-semibold uppercase tracking-wide bg-cyan-400 text-cyan-950 px-2 py-0.5 rounded-full"
                    >
                        NEW
                    </span>
                </a>
            </li>
            <li>
                <a class="hover:underline hover:decoration-cyan-400" href="/"
                    >Home</a
                >
            </li>
            <li>
                <a
                    class="hover:underline hover:decoration-cyan-400"
                    href="/#projects">Projects</a
                >
            </li>
            <li>
                <a
                    class="hover:underline hover:decoration-cyan-400"
                    href="/about">About</a
                >
            </li>
            <li class="bg-slate-500 hover:bg-cyan-800 px-4 py-2 rounded-lg">
                <a
                    href="https://www.linkedin.com/in/hector-fernandez-piquer"
                    target="_blank">¿Conectamos?</a
                >
            </li>
        </ul>
    </nav>

    <!-- Navegación Móvil flotante -->
    <nav
        id="mobile-menu"
        class="mobile-menu neon-border md:hidden absolute top-full right-2 mt-3 w-60 origin-top-right rounded-2xl border border-slate-700 bg-slate-900/95 backdrop-blur-md shadow-2xl shadow-black/50 ring-1 ring-cyan-500/10 z-40"
    >
        <ul class="flex flex-col gap-1 p-3">
            <li>
                <a
                    class="mobile-link flex items-center gap-2 rounded-xl px-3 py-2.5 text-slate-200 hover:bg-slate-800 hover:text-cyan-300 transition-colors"
                    href="/tfg"
                >
                    <span>TFG</span>
                    <span
                        class="text-[8px] font-semibold uppercase tracking-wide bg-cyan-400 text-cyan-950 px-2 py-0.5 rounded-full"
                    >
                        NEW
                    </span>
                </a>
            </li>
            <li>
                <a
                    class="mobile-link block rounded-xl px-3 py-2.5 text-slate-200 hover:bg-slate-800 hover:text-cyan-300 transition-colors"
                    href="/">Home</a
                >
            </li>
            <li>
                <a
                    class="mobile-link block rounded-xl px-3 py-2.5 text-slate-200 hover:bg-slate-800 hover:text-cyan-300 transition-colors"
                    href="/#projects">Projects</a
                >
            </li>
            <li>
                <a
                    class="mobile-link block rounded-xl px-3 py-2.5 text-slate-200 hover:bg-slate-800 hover:text-cyan-300 transition-colors"
                    href="/about">About</a
                >
            </li>
            <li class="pt-1">
                <a
                    class="mobile-link block rounded-xl bg-cyan-500/15 border border-cyan-500/40 px-3 py-2.5 text-center text-cyan-200 font-medium hover:bg-cyan-500/25 transition-colors"
                    href="https://www.linkedin.com/in/hector-fernandez-piquer"
                    target="_blank">¿Conectamos?</a
                >
            </li>
        </ul>
    </nav>
</header>

<style>
    /* Animación del logo al hacer clic: empieza lento, coge velocidad girando,
       se encoge hasta desaparecer, lanza un destello de rayos cian y reaparece. */
    .logo-img {
        transform-origin: center;
    }
    .logo-spin {
        animation: logo-spin 2.6s both;
    }

    @keyframes logo-spin {
        0% {
            transform: rotate(0deg) scale(1);
            opacity: 1;
            animation-timing-function: cubic-bezier(0.55, 0, 1, 0.45);
        }
        42% {
            transform: rotate(1080deg) scale(0);
            opacity: 0;
        }
        70% {
            transform: rotate(1080deg) scale(0);
            opacity: 0;
            animation-timing-function: cubic-bezier(0.18, 0.9, 0.3, 1);
        }
        100% {
            transform: rotate(1440deg) scale(1);
            opacity: 1;
        }
    }

    /* Destello de rayos al desaparecer */
    .logo-burst {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        pointer-events: none;
    }
    .logo-burst .ray {
        position: absolute;
        width: 2px;
        height: 16px;
        border-radius: 9999px;
        background: linear-gradient(to top, rgba(34, 211, 238, 0), #67e8f9);
        filter: drop-shadow(0 0 5px #22d3ee);
        opacity: 0;
        transform: rotate(var(--a)) translateY(-6px) scaleY(0.4);
    }
    .logo-burst.burst .ray {
        animation: logo-ray 0.55s ease-out 0.95s;
    }

    @keyframes logo-ray {
        0% {
            opacity: 0;
            transform: rotate(var(--a)) translateY(-6px) scaleY(0.4);
        }
        35% {
            opacity: 1;
            transform: rotate(var(--a)) translateY(-20px) scaleY(1);
        }
        100% {
            opacity: 0;
            transform: rotate(var(--a)) translateY(-36px) scaleY(0.3);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .logo-spin,
        .logo-burst.burst .ray {
            animation: none;
        }
    }

    .bar {
        transition:
            transform 0.3s ease,
            opacity 0.2s ease,
            background-color 0.3s ease,
            box-shadow 0.3s ease;
    }

    .menu-button.open .bar {
        background-color: #22d3ee;
        animation: bar-glow 1.4s ease-in-out infinite;
    }
    .menu-button.open .bar-1 {
        transform: translateY(8px) rotate(45deg);
    }
    .menu-button.open .bar-2 {
        opacity: 0;
        transform: scaleX(0);
    }
    .menu-button.open .bar-3 {
        transform: translateY(-8px) rotate(-45deg);
    }

    @keyframes bar-glow {
        0%,
        100% {
            box-shadow: 0 0 6px rgba(34, 211, 238, 0.6);
        }
        50% {
            box-shadow: 0 0 14px rgba(34, 211, 238, 1);
        }
    }

    .mobile-menu {
        opacity: 0;
        transform: translateY(-8px) scale(0.96);
        pointer-events: none;
        transition:
            opacity 0.25s ease,
            transform 0.25s ease;
    }
    .mobile-menu.open {
        opacity: 1;
        transform: translateY(0) scale(1);
        pointer-events: auto;
    }

    @media (prefers-reduced-motion: reduce) {
        .bar,
        .mobile-menu {
            transition: none;
        }
        .menu-button.open .bar {
            animation: none;
        }
    }
</style>

<script>
    let docListenersBound = false;

    function closeMenu() {
        const btn = document.getElementById("menu-button");
        const menu = document.getElementById("mobile-menu");
        if (!btn || !menu) return;
        btn.classList.remove("open");
        menu.classList.remove("open");
        btn.setAttribute("aria-expanded", "false");
        btn.setAttribute("aria-label", "Abrir menú");
    }

    function initMobileMenu() {
        const btn = document.getElementById("menu-button");
        const menu = document.getElementById("mobile-menu");
        if (!btn || !menu) return;

        // Bind del botón: solo una vez por elemento (idempotente).
        if (btn.dataset.bound !== "true") {
            btn.dataset.bound = "true";

            btn.addEventListener("click", (e) => {
                e.stopPropagation();
                const isOpen = btn.classList.toggle("open");
                menu.classList.toggle("open", isOpen);
                btn.setAttribute("aria-expanded", String(isOpen));
                btn.setAttribute(
                    "aria-label",
                    isOpen ? "Cerrar menú" : "Abrir menú",
                );
            });

            menu.querySelectorAll("a").forEach((link) => {
                link.addEventListener("click", closeMenu);
            });
        }

        // Animación del logo al hacer clic (idempotente por elemento).
        const logo = document.getElementById("logo-link");
        const logoImg = logo?.querySelector("img");
        const logoBurst = logo?.querySelector(".logo-burst");
        if (logo && logoImg && logo.dataset.bound !== "true") {
            logo.dataset.bound = "true";
            logo.addEventListener("click", () => {
                logoImg.classList.remove("logo-spin");
                logoBurst?.classList.remove("burst");
                void logoImg.offsetWidth; // reinicia la animación si se repite
                logoImg.classList.add("logo-spin");
                logoBurst?.classList.add("burst");
            });
            logoImg.addEventListener("animationend", () => {
                logoImg.classList.remove("logo-spin");
                logoBurst?.classList.remove("burst");
            });
        }

        // Listeners globales: solo una vez por documento.
        if (!docListenersBound) {
            docListenersBound = true;

            document.addEventListener("click", (e) => {
                const b = document.getElementById("menu-button");
                const m = document.getElementById("mobile-menu");
                if (!b || !m || !b.classList.contains("open")) return;
                const target = e.target as Node;
                if (!m.contains(target) && !b.contains(target)) closeMenu();
            });

            document.addEventListener("keydown", (e) => {
                if (e.key === "Escape") closeMenu();
            });
        }
    }

    document.addEventListener("astro:page-load", initMobileMenu);
</script>
