---
import { Image } from "astro:assets";
import { currentSkills, skills } from "../data/skills";
---

<!-- Hero Section -->
    <main id="hero" class="scroll-mt-24 relative overflow-hidden px-6 pt-3 pb-6 lg:pt-8 lg:pb-32">
        <div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-12 items-center lg:items-start">
            <!-- Columna Izquierda: Texto -->
            <div class="order-2 lg:order-1 text-center lg:text-left space-y-6">
                <div class="flex justify-center lg:justify-start">
                    <span
                        class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-xs font-semibold tracking-wide text-emerald-300"
                    >
                        <span class="relative flex h-2 w-2">
                            <span
                                class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"
                            ></span>
                            <span
                                class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"
                            ></span>
                        </span>
                        Disponible para nuevos proyectos
                    </span>
                </div>

                <h1
                    class="text-4xl md:text-6xl font-black tracking-tight text-white leading-tight"
                >
                    Ya no tan <span class="text-cyan-400">a la deriva </span>
                </h1>

                <div
                    class="space-y-4 text-lg text-slate-400 max-w-2xl mx-auto lg:mx-0"
                >
                    <p>
                        Pasé de coordinar equipos en el sector industrial a
                        crear mi primera aplicación para resolver problemas
                        reales.
                    </p>
                    <p>
                        Actualmente, como <span
                            class="text-slate-100 font-semibold"
                            >desarrollador Full Stack mid-level</span
                        >, fusiono la pragmática industrial con la innovación
                        digital. Abierto a nuevos proyectos y colaboraciones.
                    </p>
                </div>

                <!-- CTA -->
                <div class="pt-1 flex justify-center lg:justify-start">
                    <a
                        href="mailto:hola@hiscle.com?subject=DEMOSLE%20FORMA"
                        class="group relative inline-flex w-full sm:w-auto items-center justify-center gap-2.5 rounded-2xl border border-cyan-500/40 bg-cyan-500/10 px-5 py-3 text-sm sm:text-base font-semibold text-cyan-100 text-center leading-snug transition-all duration-300 hover:-translate-y-0.5 hover:border-cyan-400/60 hover:bg-cyan-500/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
                    >
                        <svg
                            class="shrink-0"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <rect x="2" y="4" width="20" height="16" rx="2" />
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                        </svg>
                        ¿Le damos forma a lo que tienes en mente?
                        <svg
                            class="shrink-0 transition-transform duration-300 group-hover:translate-x-1"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <line x1="5" y1="12" x2="19" y2="12" />
                            <polyline points="12 5 19 12 12 19" />
                        </svg>
                    </a>
                </div>

                <!-- Skills Row -->
                <div class="pt-6">
                    <p
                        class="text-sm font-mono text-cyan-500 mb-4 tracking-widest uppercase"
                    >
                        Tecnologías que uso actualmente:
                    </p>
                    <div
                        class="flex flex-wrap justify-center lg:justify-start gap-5"
                    >
                        {
                            currentSkills.map((skill) => (
                                skill.svg ? (
                                    <span
                                        title={skill.name}
                                        class={`inline-flex align-middle hover:scale-125 transition-transform cursor-help ${skill.color ?? "text-slate-200"}`}
                                    >
                                        <svg
                                            width="30"
                                            height="30"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            aria-hidden="true"
                                            set:html={skill.svg}
                                        />
                                    </span>
                                ) : (
                                    <i
                                        class={`devicon-${skill.icon}  text-3xl hover:scale-125 transition-transform cursor-help`}
                                        title={skill.name}
                                    />
                                )
                            ))
                        }
                    </div>
                </div>
                <div class="pt-6">
                    <p
                        class="text-sm font-mono text-cyan-500 mb-4 tracking-widest uppercase"
                    >
                        Tecnologías usadas:
                    </p>
                    <div
                        class="flex flex-wrap justify-center lg:justify-start gap-5"
                    >
                        {
                            skills.map((skill) => (
                                skill.svg ? (
                                    <span
                                        title={skill.name}
                                        class={`inline-flex align-middle hover:scale-125 transition-transform cursor-help ${skill.color ?? "text-slate-200"}`}
                                    >
                                        <svg
                                            width="30"
                                            height="30"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            aria-hidden="true"
                                            set:html={skill.svg}
                                        />
                                    </span>
                                ) : (
                                    <i
                                        class={`devicon-${skill.icon}  text-3xl hover:scale-125 transition-transform cursor-help`}
                                        title={skill.name}
                                    />
                                )
                            ))
                        }
                    </div>
                </div>
            </div>

            <!-- Columna Derecha: Foto -->
            <div class="order-1 lg:order-2 flex justify-center lg:mt-16">
                <div class="relative group perspective-[1000px]">
                    <!-- Efecto de resplandor de fondo -->
                    <div
                        class="absolute -inset-1 bg-linear-to-r from-cyan-500 to-blue-600 rounded-full blur opacity-25 group-hover:opacity-50 transition duration-1000"
                    >
                    </div>
                    <Image
                        class="relative rounded-full w-48 h-48 md:w-70 md:h-70 object-cover border-4 border-slate-900 shadow-2xl transition-transform duration-500 group-hover:[transform:rotateY(15deg)]"
                        src="/me.webp"
                        alt="Foto de perfil"
                        width={280}
                        height={280}
                    />
                </div>
            </div>
        </div>
    </main>