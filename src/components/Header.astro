---
import { Image } from "astro:assets";
---

<header
    class="mb-10 px-4 mx-auto w-full flex justify-between items-center p-2 bg-slate-700 border-b-2 border-slate-400 relative"
>
    <a href="/#hero"
        ><Image
            src="/icon.webp"
            alt="Logo"
            width={64}
            height={64}
            class="w-16 h-16"
        /></a
    >

    <!-- Botón con ID para el script -->
    <button
        id="menu-button"
        class="md:hidden flex flex-col justify-center items-center w-8 h-8 focus:outline-none"
    >
        <span class="bg-white w-6 h-0.5 rounded mb-1"></span>
        <span class="bg-white w-6 h-0.5 rounded mb-1"></span>
        <span class="bg-white w-6 h-0.5 rounded"></span>
    </button>

    <!-- Navegación Desktop -->
    <nav class="hidden md:block">
        <ul class="flex gap-7 items-center">
            <li>
                <a class="hover:underline hover:decoration-cyan-400" href="/"
                    >Home</a>
            </li>
            <li>
                <a
                    class="hover:underline hover:decoration-cyan-400"
                    href="/#projects">Projects</a>
            </li>
            <li>
                <a
                    class="hover:underline hover:decoration-cyan-400"
                    href="/about">About</a>
            </li>
            <li class="bg-slate-500 hover:bg-cyan-800 px-4 py-2 rounded-lg">
                <a
                    href="https://www.linkedin.com/in/hector-fernandez-piquer"
                    target="_blank">¿Conectamos?</a>
            </li>
        </ul>
    </nav>

    <!-- Navegación Móvil con ID -->
    <nav
        id="mobile-menu"
        class="hidden absolute top-full left-0 right-0 bg-slate-700 border-b-2 border-slate-400 md:hidden z-50"
    >
        <ul class="flex flex-col gap-4 p-4">
            <li><a class="mobile-link block py-2" href="/">Home</a></li>
            <li>
                <a class="mobile-link block py-2" href="/#projects">Projects</a>
            </li>
            <li><a class="mobile-link block py-2" href="/about">About</a></li>
            <li class="bg-slate-500 text-center rounded-lg">
                <a
                    class="mobile-link block py-2"
                    href="https://www.linkedin.com/in/hector-fernandez-piquer"
                    >¿Conectamos?</a>
            </li>
        </ul>
    </nav>
</header>

<script>
    // Usamos una sola función que se encargue de todo
    function initMobileMenu() {
        const btn = document.getElementById("menu-button");
        const menu = document.getElementById("mobile-menu");
        const links = document.querySelectorAll(".mobile-link");

        if (!btn || !menu) return;

        // Función para abrir/cerrar
        const toggle = () => menu.classList.toggle("hidden");
        
        // Función para cerrar (cuando se hace click en un link)
        const close = () => menu.classList.add("hidden");

        // Limpiamos listeners por seguridad y los añadimos
        btn.removeEventListener("click", toggle);
        btn.addEventListener("click", toggle);

        links.forEach((link) => {
            link.removeEventListener("click", close);
            link.addEventListener("click", close);
        });
    }

    document.addEventListener("astro:page-load", initMobileMenu);
</script>