---
/* src/components/TFGFeature.astro */
import VideoMockup from "./VideoMockup.astro";

interface Props {
  title: string;
  description: string;
  videoSrc: string;
  videoAlt: string;
  reverse?: boolean;
}

const { title, description, videoSrc, videoAlt, reverse = false } = Astro.props;
---

<article class="flex flex-col lg:grid lg:grid-cols-12 gap-6 lg:gap-10 items-center">
  <div class={`w-full lg:col-span-3 space-y-3 ${reverse ? "lg:order-2" : ""}`}>
    <h3 class="text-2xl font-bold text-white tracking-tight">
      {title}
    </h3>
    <p class="text-slate-400 leading-relaxed text-base">
      {description}
    </p>
  </div>
  
  <div class={`w-full lg:col-span-9 ${reverse ? "lg:order-1" : ""}`}>
    <VideoMockup src={videoSrc} altText={videoAlt} />
  </div>
</article>
