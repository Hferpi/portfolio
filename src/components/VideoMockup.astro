---
interface Props {
  src: string;
  altText: string;
}

const { src, altText } = Astro.props;
// Detectar el tipo de video basándose en la extensión
const type = src.endsWith('.webm') ? 'video/webm' : 'video/mp4';
---

<!-- Contenedor del falso navegador (usando Tailwind CSS) -->
<div class="rounded-xl border border-gray-700 bg-gray-900 shadow-2xl overflow-hidden w-full">
  
  <!-- Barra superior con los botones de Mac -->
  <div class="flex items-center px-4 py-3 bg-gray-800 border-b border-gray-700">
    <div class="flex space-x-2">
      <div class="w-3 h-3 rounded-full bg-red-500"></div>
      <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
      <div class="w-3 h-3 rounded-full bg-green-500"></div>
    </div>
  </div>

  <div class="bg-black flex items-center justify-center overflow-hidden aspect-video">
    <video 
      autoplay 
      loop 
      muted 
      playsinline 
      class="w-full h-full block object-contain"
      aria-label={altText}
    >
      <source src={src} type={type} />
      Tu navegador no soporta la etiqueta de video.
    </video>
  </div>
  
</div>