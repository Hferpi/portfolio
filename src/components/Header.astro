---
import { Image } from "astro:assets";
const menuOpen = false;
---
<header class="mb-10 px-4 mx-auto w-full flex justify-between items-center p-2 bg-slate-700 border-b-2 border-slate-400 relative">
	<a href="/#hero"><Image src="/icon.webp" alt="Logo" width={64} height={64} class="w-16 h-16"/></a>
	
	<!-- Mobile menu button -->
	<button class="md:hidden flex flex-col justify-center items-center w-8 h-8" onclick="this.parentElement.querySelector('.mobile-menu').classList.toggle('hidden')">
		<span class="bg-white w-6 h-0.5 rounded mb-1"></span>
		<span class="bg-white w-6 h-0.5 rounded mb-1"></span>
		<span class="bg-white w-6 h-0.5 rounded"></span>
	</button>

	<!-- Desktop navigation -->
	<nav class="hidden md:block">
		<ul class="flex gap-7 items-center">
			<li><a class="hover:underline hover:decoration-cyan-400 hover:decoration-2" href="/">Home</a></li>
			<li><a class="hover:underline hover:decoration-cyan-400 hover:decoration-2" href="/#projects">Projects</a></li>
			<li><a class="hover:underline hover:decoration-cyan-400 hover:decoration-2" href="/about">About</a></li>
	<li class="bg-slate-500 hover:bg-cyan-800 px-4 py-2 rounded-lg text-center"><a href="https://www.linkedin.com/in/hector-fern%C3%A1ndez-piquer-90026a165/" target="_blank">Conectamos?</a></li>
		</ul>
	</nav>

	<!-- Mobile navigation -->
	<nav class="mobile-menu hidden absolute top-full left-0 right-0 bg-slate-700 border-b-2 border-slate-400 md:hidden z-10">
		<ul class="flex flex-col gap-4 p-4">
			<li><a class="hover:underline hover:decoration-cyan-400 hover:decoration-2 block py-2" href="#home">Home</a></li>
			<li><a class="hover:underline hover:decoration-cyan-400 hover:decoration-2 block py-2" href="#projects">Projects</a></li>
			<li><a class="hover:underline hover:decoration-cyan-400 hover:decoration-2 block py-2" href="#about">About</a></li>
			<li class="bg-slate-500 hover:bg-cyan-800 px-4 py-2 rounded-lg text-center"><a href="https://www.linkedin.com/in/hector-fern%C3%A1ndez-piquer-90026a165/" target="_blank">Conectamos?</a></li>
		</ul>
	</nav>
</header>