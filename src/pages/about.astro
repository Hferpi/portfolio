---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";

const softSkills = [
    "Responsabilidad y Compromiso",
    "Lógica de procesos industriales",
    "Gestión de equipos (Liderazgo)",
    "Resolución de problemas complejos",
    "Orientación a resultados",
];
---

<Layout
    title="Sobre mí | Héctor Fernández Piquer"
    description="Trayectoria de Héctor Fernández: 10 años en logística industrial y formación en Desarrollo Web. Full Stack Junior con mentalidad de resolución de problemas reales."
    ogImage="/logo.webp"
>
    <main class="bg-slate-950 text-slate-200 min-h-screen pb-20 px-6">
        <div class="max-w-6xl mx-auto pt-16 lg:pt-24">
            <!-- Título de Sección -->
            <div class="mb-12">
                <span
                    class="font-mono text-cyan-500 text-sm tracking-widest uppercase"
                    >01. Trayectoria</span
                >
                <h1 class="text-5xl font-black text-white mt-2">Sobre mí</h1>
            </div>

            <!-- Grid Principal: Historia -->
            <div class="grid md:grid-cols-[1fr_250px] gap-12 items-start">
                <div class="space-y-6 text-lg text-slate-400 leading-relaxed">
                    <p>
                        Mi camino en el mundo del software no es el habitual.
                        Durante una década, mi entorno fueron las plantas
                        industriales y la logística del <span
                            class="text-white font-medium"
                            >sector de la madera</span
                        >.
                    </p>

                    <p>
                        Pasé de mover materiales a <span class="text-cyan-400"
                            >coordinar equipos</span
                        >. Fue allí donde descubrí mi verdadera vocación:
                        detecté ineficiencias en los procesos diarios y, por
                        iniciativa propia, desarrollé mi primera aplicación para
                        automatizarlos. Esa necesidad de solucionar problemas
                        reales mediante la tecnología me llevó a dar el salto
                        definitivo.
                    </p>

                    <blockquote
                        class="border-l-4 border-cyan-500 pl-6 py-2 my-8 bg-slate-900/50 italic text-slate-300"
                    >
                        "No solo escribo código; entiendo el negocio desde la
                        base para crear herramientas que realmente aporten valor
                        a quienes las usan."
                    </blockquote>

                    <p>
                        Recientemente finalicé mi formación en <span
                            class="text-white">Desarrollo Web</span
                        > con un <span
                            class="text-cyan-400 font-bold underline decoration-2 underline-offset-4"
                            >Expediente de Excelencia (Nota 9)</span
                        >, mi visión es seguir creciendo y aprendiendo. <span
                            class="text-lime-500"
                            >Interesado en la ciberseguridad</span
                        >
                    </p>
                </div>

                <!-- Foto / Perfil Lateral -->
                <aside class="space-y-8">
                    <div class="relative group mx-auto w-fit">
                        <!-- Añadí mx-auto y w-fit para centrar en móvil -->
                        <div
                            class="absolute -inset-2 bg-linear-to-b from-cyan-500 to-blue-600 rounded-xl blur opacity-20 group-hover:opacity-40 transition"
                        >
                        </div>
                        <Image
                            src="/me.webp"
                            alt="Héctor Fernández"
                            width={250}
                            height={250}
                            class="relative rounded-xl grayscale hover:grayscale-0 transition duration-500 border border-slate-800 object-cover aspect-square w-full h-auto max-w-[250px]"
                        />
                    </div>

                    <div class="font-mono text-sm space-y-2">
                        <p class="text-cyan-500 font-bold uppercase">
                            Ubicación
                        </p>
                        <p class="text-slate-400">Vinaròs, Castellón</p>

                        <p class="text-cyan-500 font-bold uppercase pt-4">
                            Educación
                        </p>
                        <p class="text-slate-400">
                            Desarrollo de Aplicaciones Web (Exp. Excelencia)
                        </p>
                    </div>
                </aside>
            </div>

            <!-- Sección de Habilidades Transversales (Tu ventaja competitiva) -->
            <section class="mt-24">
                <div
                    class="bg-slate-900/30 border border-slate-800 rounded-3xl p-8 md:p-12"
                >
                    <h2 class="text-3xl font-bold text-white mb-8">
                        Por qué mi perfil es <span class="text-cyan-500"
                            >diferente</span>
                    </h2>

                    <div class="grid md:grid-cols-2 gap-8">
                        <div class="space-y-4">
                            <h3
                                class="font-mono text-xl text-slate-200 flex items-center gap-2"
                            >
                                <span class="text-cyan-500">_</span> Mentalidad Industrial
                            </h3>
                            <p class="text-slate-400">
                                10 años en logística me han enseñado que un
                                error en el proceso cuesta dinero. Aplico esa
                                misma rigurosidad al backend y a la arquitectura
                                de software.
                            </p>
                        </div>

                        <div class="space-y-4">
                            <h3
                                class="font-mono text-xl text-slate-200 flex items-center gap-2"
                            >
                                <span class="text-cyan-500">_</span> Trabajo en equipo
                            </h3>
                            <p class="text-slate-400">
                                Gracias a trabjar con equipos, sé lo que
                                significa el compañerismo y la responsabilidad.
                                Me integro fácilmente en células de desarrollo
                                aportando calma y soluciones.
                            </p>
                        </div>
                    </div>

                    <div class="mt-12 flex flex-wrap gap-3">
                        {
                            softSkills.map((skill) => (
                                <span class="px-4 py-2 bg-slate-800/50 border border-slate-700 rounded-full text-sm font-medium text-slate-300">
                                    {skill}
                                </span>
                            ))
                        }
                    </div>
                </div>
            </section>
        </div>
    </main>
    <script
        type="application/ld+json"
        set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "Person",
            name: "Héctor Fernández Piquer",
            jobTitle: "Full Stack Developer Junior",
            url: "https://hferpi.com",
            image: "https://hferpi.com/logo.webp",
            address: {
                "@type": "PostalAddress",
                addressLocality: "Vinaròs",
                addressRegion: "Castellón",
            },
            knowsAbout: [
                "Desarrollo Web",
                "Full Stack",
                "Logística Industrial",
            ],
        })}
    />
</Layout>
